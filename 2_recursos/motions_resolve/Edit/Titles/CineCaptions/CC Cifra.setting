{
	Tools = ordered() {
		CCCifra = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Numero", Source = "Valor", Name = "Número", },
				Input2 = InstanceInput { SourceOp = "Numero", Source = "Prefijo", Name = "Antes del número", },
				Input3 = InstanceInput { SourceOp = "Numero", Source = "Sufijo", Name = "Después del número", },
				Input4 = InstanceInput { SourceOp = "Etiqueta", Source = "StyledText", Name = "Etiqueta", },
				Input5 = InstanceInput { SourceOp = "Numero", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input6 = InstanceInput { SourceOp = "Numero", Source = "Style", ControlGroup = 2, },
				Input7 = InstanceInput { SourceOp = "Acento", Source = "TopLeftRed", Name = "Color de acento", ControlGroup = 4, },
				Input8 = InstanceInput { SourceOp = "Acento", Source = "TopLeftGreen", ControlGroup = 4, },
				Input9 = InstanceInput { SourceOp = "Acento", Source = "TopLeftBlue", ControlGroup = 4, },
				Input10 = InstanceInput { SourceOp = "Encuadre", Source = "Center", Name = "Posición", },
				Input11 = InstanceInput { SourceOp = "Encuadre", Source = "Size", Name = "Tamaño", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Encuadre", Source = "Output", }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Acento = Background {
					CtrlWZoom = false,
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					TopLeftRed = Input { Value = 0.3, },
					TopLeftGreen = Input { Value = 0.49, },
					TopLeftBlue = Input { Value = 1, },
					TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -80 } },
				},
				Numero = TextPlus {
					CtrlWZoom = false,
					UserControls = ordered() {
						Valor = { LINKS_Name = "Número", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = false, INP_MinScale = 0, INP_MaxScale = 1000, INP_Default = 250, ICS_ControlPage = "Text", },
						Prefijo = { LINKS_Name = "Antes del número", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1, ICS_ControlPage = "Text", },
						Sufijo = { LINKS_Name = "Después del número", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1, ICS_ControlPage = "Text", },
					},
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					Wrap = Input { Value = 0, },
					Center = Input { Value = { 0.5, 0.53 }, },
					Red1 = Input { Value = 0.3, Expression = "Acento.TopLeftRed", },
					Green1 = Input { Value = 0.49, Expression = "Acento.TopLeftGreen", },
					Blue1 = Input { Value = 1, Expression = "Acento.TopLeftBlue", },
					StyledText = Input { Value = "+250%", Expression = "('%s%d%s'):format(tostring(Numero.Prefijo.Value), math.floor(Numero.Valor * (1 - (1 - (math.min(1, math.max(0, (time - comp.RenderStart - 4) / 34))))^3) + 0.5), tostring(Numero.Sufijo.Value))", },
					Font = Input { Value = "Montserrat", },
					Style = Input { Value = "ExtraBold", },
					Size = Input { Value = 0.16, },
					VerticalJustificationNew = Input { Value = 3, },
					HorizontalJustificationNew = Input { Value = 3, },
					Enabled4 = Input { Value = 1, },
					Red4 = Input { Value = Number { Value = 0 }, },
					Green4 = Input { Value = Number { Value = 0 }, },
					Blue4 = Input { Value = Number { Value = 0 }, },
					Opacity4 = Input { Value = Number { Value = 0.5 }, },
					Offset4 = Input { Value = Point { X = 0, Y = -0.006 }, },
					Softness4 = Input { Value = Number { Value = 1 }, },
					SoftnessX4 = Input { Value = Number { Value = 10 }, },
					SoftnessY4 = Input { Value = Number { Value = 10 }, },
					Valor = Input { Value = 250, },
					Prefijo = Input { Value = "+", },
					Sufijo = Input { Value = "%", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Etiqueta = TextPlus {
					CtrlWZoom = false,
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					Wrap = Input { Value = 0, },
					Center = Input { Value = { 0.5, 0.425 }, },
					Red1 = Input { Value = 1, },
					Green1 = Input { Value = 1, },
					Blue1 = Input { Value = 1, },
					StyledText = Input { Value = "seguidores nuevos", },
					Font = Input { Value = "Inter 18pt", },
					Style = Input { Value = "Medium", },
					Size = Input { Value = 0.052, },
					VerticalJustificationNew = Input { Value = 3, },
					HorizontalJustificationNew = Input { Value = 3, },
					Enabled4 = Input { Value = 1, },
					Red4 = Input { Value = Number { Value = 0 }, },
					Green4 = Input { Value = Number { Value = 0 }, },
					Blue4 = Input { Value = Number { Value = 0 }, },
					Opacity4 = Input { Value = Number { Value = 0.5 }, },
					Offset4 = Input { Value = Point { X = 0, Y = -0.006 }, },
					Softness4 = Input { Value = Number { Value = 1 }, },
					SoftnessX4 = Input { Value = Number { Value = 10 }, },
					SoftnessY4 = Input { Value = Number { Value = 10 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 60 } },
				},
				BarraMask = RectangleMask {
					CtrlWZoom = false,
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					SoftEdge = Input { Value = 0.0006, },
					Center = Input { Value = { 0.5, 0.465 }, },
					Width = Input { Value = 0.3, Expression = "0.3 * (1 - (1 - (math.min(1, math.max(0, (time - comp.RenderStart - 10) / 14))))^3) * math.min(1, math.max(0, (comp.RenderEnd - time) / 8))", },
					Height = Input { Value = 0.008, },
					CornerRadius = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { -160, 140 } },
				},
				Barra = Background {
					CtrlWZoom = false,
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					TopLeftRed = Input { Value = 1, Expression = "Acento.TopLeftRed", },
					TopLeftGreen = Input { Value = 1, Expression = "Acento.TopLeftGreen", },
					TopLeftBlue = Input { Value = 1, Expression = "Acento.TopLeftBlue", },
					TopLeftAlpha = Input { Value = 1, },
					EffectMask = Input { SourceOp = "BarraMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { -60, 140 } },
				},
				Vacio = Background {
					CtrlWZoom = false,
					Inputs = {
					UseFrameFormatSettings = Input { Value = 1, },
					TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 260 } },
				},
				Anim1 = Transform {
					CtrlWZoom = false,
					Inputs = {
					Input = Input { SourceOp = "Numero", Source = "Output", },
					Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0, 0.5 + 0)", },
					Pivot = Input { Value = { 0.5, 0.53 }, },
					Size = Input { Value = 1, Expression = "(0.6 + 0.4*(1 + 2.70158*((math.min(1, math.max(0, (time - comp.RenderStart - 0) / 12)))-1)^3 + 1.70158*((math.min(1, math.max(0, (time - comp.RenderStart - 0) / 12)))-1)^2)) * (0.92 + 0.08*math.min(1, math.max(0, (comp.RenderEnd - time) / 8)))", },
					Angle = Input { Value = 0, Expression = "0", },
					},
					ViewInfo = OperatorInfo { Pos = { 160, 120 } },
				},
				Capa1 = Merge {
					CtrlWZoom = false,
					Inputs = {
					Background = Input { SourceOp = "Vacio", Source = "Output", },
					Foreground = Input { SourceOp = "Anim1", Source = "Output", },
					Blend = Input { Value = 1, Expression = "math.min(1, math.min(1, math.max(0, (time - comp.RenderStart - 0) / 12)) * 2.5) * math.min(1, math.max(0, (comp.RenderEnd - time) / 8))", },
					PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 160, 260 } },
				},
				Anim2 = Transform {
					CtrlWZoom = false,
					Inputs = {
					Input = Input { SourceOp = "Barra", Source = "Output", },
					Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0, 0.5 + 0)", },
					Pivot = Input { Value = { 0.5, 0.5 }, },
					Size = Input { Value = 1, Expression = "1", },
					Angle = Input { Value = 0, Expression = "0", },
					},
					ViewInfo = OperatorInfo { Pos = { 320, 120 } },
				},
				Capa2 = Merge {
					CtrlWZoom = false,
					Inputs = {
					Background = Input { SourceOp = "Capa1", Source = "Output", },
					Foreground = Input { SourceOp = "Anim2", Source = "Output", },
					Blend = Input { Value = 1, Expression = "math.min(1, math.max(0, (comp.RenderEnd - time) / 8))", },
					PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 320, 260 } },
				},
				Anim3 = Transform {
					CtrlWZoom = false,
					Inputs = {
					Input = Input { SourceOp = "Etiqueta", Source = "Output", },
					Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0, 0.5 + (1 - (1 - (1 - (math.min(1, math.max(0, (time - comp.RenderStart - 10) / 12))))^3)) * (-0.02))", },
					Pivot = Input { Value = { 0.5, 0.5 }, },
					Size = Input { Value = 1, Expression = "1", },
					Angle = Input { Value = 0, Expression = "0", },
					},
					ViewInfo = OperatorInfo { Pos = { 480, 120 } },
				},
				Capa3 = Merge {
					CtrlWZoom = false,
					Inputs = {
					Background = Input { SourceOp = "Capa2", Source = "Output", },
					Foreground = Input { SourceOp = "Anim3", Source = "Output", },
					Blend = Input { Value = 1, Expression = "(1 - (1 - (math.min(1, math.max(0, (time - comp.RenderStart - 10) / 12))))^3) * math.min(1, math.max(0, (comp.RenderEnd - time) / 8))", },
					PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 480, 260 } },
				},
				Encuadre = Transform {
					CtrlWZoom = false,
					Inputs = {
					Input = Input { SourceOp = "Capa3", Source = "Output", },
					Center = Input { Value = { 0.5, 0.5 }, },
					Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 640, 260 } },
				},
			},
			UserControls = ordered() { CCBanner = { LINKS_Name = "<center><img src='data:image/png;base64,' width='300'><br><font color='#9AA3B5'>Personaliza aquí tu motion: textos, colores, posición y tamaño</font></center>", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_MultiLine = true, INP_External = false, INP_Passive = true, IC_NoLabel = true, IC_NoReset = true, IC_ControlPage = -1, }, }
		}
	},
	ActiveTool = "CCCifra"
}
